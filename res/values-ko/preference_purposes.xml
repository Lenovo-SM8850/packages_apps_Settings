<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="installed_app_detail_settings_screen_purpose">지정한 설치된 앱의 상세 정보와 관리 옵션을 제공합니다.</string>
    <string name="installed_app_detail_unused_apps_switch_purpose">사용 설정하면 앱을 사용하지 않는 동안 권한을 삭제하고, 임시 파일을 삭제하고, 알림을 중지하고, 앱을 보관 처리합니다.</string>
    <string name="installed_app_detail_manage_app_unused_precondition_disabled_globally">\'미사용 시 앱 관리\' 기능이 현재 기기 수준에서 사용 중지되어 있습니다.</string>
    <string name="installed_app_detail_manage_app_unused_precondition_archived_app">보관 처리된 앱은 미사용 앱으로 관리할 수 없습니다.</string>
    <string name="installed_app_detail_manage_app_unused_precondition_exempt_app">이 앱은 중요한 시스템 앱이므로 \'미사용 시 앱 관리\' 기능에서 제외됩니다.</string>
    <string name="installed_app_detail_manage_app_unused_precondition_null_app">지정한 앱을 기기에서 찾을 수 없습니다.</string>
    <string name="non_carrier_app_data_usage_screen_purpose">모바일 데이터와 Wi-Fi 연결에서 앱이 사용한 데이터 양을 표시합니다.</string>
</resources>
