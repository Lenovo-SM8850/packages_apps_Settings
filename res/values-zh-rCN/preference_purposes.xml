<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="installed_app_detail_settings_screen_purpose">提供指定已安装应用的详细信息和管理选项，包括权限、存储空间、通知和状态。</string>
    <string name="installed_app_detail_unused_apps_switch_purpose">启用后，如果长时间未使用应用，系统将移除权限、删除临时文件、停止通知并归档该应用。</string>
    <string name="installed_app_detail_manage_app_unused_precondition_disabled_globally">“管理闲置应用”功能目前已在设备级别停用。</string>
    <string name="installed_app_detail_manage_app_unused_precondition_archived_app">已归档的应用无法作为闲置应用进行管理。</string>
    <string name="installed_app_detail_manage_app_unused_precondition_exempt_app">此应用是关键系统应用，不受“管理闲置应用”功能影响。</string>
    <string name="installed_app_detail_manage_app_unused_precondition_null_app">在设备上找不到指定的应用。</string>
    <string name="non_carrier_app_data_usage_screen_purpose">显示应用通过移动数据和 Wi-Fi 连接使用的流量。</string>
</resources>
